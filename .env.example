# ─── Dependency-Track Risk Dashboard — Environment Configuration ──────────────
# Copy this file to .env and fill in your values.
# The install.sh script handles this automatically when run interactively.

# ─── Dashboard ────────────────────────────────────────────────────────────────
# Port the custom risk dashboard is served on (host machine).
DT_DASHBOARD_PORT=3000

# Where nginx proxies /api/* requests — your DependencyTrack API server.
# Use the internal Docker network name if DT runs on the same host,
# or a full URL for an external / remote DT instance.
#   Same host (Docker network): http://dtrack-apiserver:8080   (default)
#   External instance:          https://dtrack.company.com
DT_API_INTERNAL_URL=http://dtrack-apiserver:8080

# Optional: pre-configure the DT API key so the dashboard auto-connects on open.
# Leave blank to require manual entry in the dashboard's "Connect API" modal.
# Generate a key in DT: Administration → Access Management → Teams → API Keys
DT_API_KEY=

# Optional: DependencyTrack UI base URL — enables clickable project links in the
# dashboard table. Leave blank to disable project links.
#   Example: DT_FRONTEND_URL=https://dtrack.company.com
DT_FRONTEND_URL=

# ─── Violation Cache ──────────────────────────────────────────────────────────
# How many hours the violation cache file is considered valid before the service
# auto-rebuilds it. Default is 24 hours.
VIOLATION_CACHE_TTL_HOURS=24

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
# The system of record for users, sessions, per-user configuration and reports.
# install.sh generates POSTGRES_PASSWORD when it is absent.
#
# The violation-cache service will NOT start if it cannot reach the database:
# schema migrations must complete before it accepts requests.
POSTGRES_USER=dtdash
POSTGRES_PASSWORD=
POSTGRES_DB=dtdash

# Host port the database is published on, so administrators can attach pgAdmin
# or DBeaver from outside Docker. Change it if 5432 is already in use locally.
POSTGRES_PORT=5432

# ─── Sessions ─────────────────────────────────────────────────────────────────
# A session ends after SESSION_ABSOLUTE_HOURS from login, or after
# SESSION_IDLE_HOURS without a request — whichever comes first.
# Only one session may be live per account: signing in elsewhere prompts to
# disconnect the existing one.
SESSION_ABSOLUTE_HOURS=8
SESSION_IDLE_HOURS=2

# ─── Secret encryption ────────────────────────────────────────────────────────
# AES-256-GCM key protecting DependencyTrack API keys and SMTP passwords at rest.
# install.sh generates one (64 hex characters) when it is absent.
#
# BACK THIS UP. Losing or changing it makes every stored secret undecryptable;
# affected users are asked to re-enter their API key.
SECRET_ENCRYPTION_KEY=

# ─── Administrator account ────────────────────────────────────────────────────
# Read by install.sh ONLY, when creating violation-cache/data/admin-credentials.json.
# The running service never reads these — it reads the hashed credentials file.
# Leave blank to be prompted, or to accept the defaults in a non-interactive install.
#   Defaults: admin / ScaAdmin@dt8624   (change the password after first sign-in)
SCA_ADMIN_USER=admin
SCA_ADMIN_PASSWORD=

# ─── Logging ──────────────────────────────────────────────────────────────────
# "text" (default) or "json" for newline-delimited structured output.
LOG_FORMAT=text
