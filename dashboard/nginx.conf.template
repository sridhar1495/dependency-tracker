# SPDX-License-Identifier: MIT
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Resolve upstream hostnames per-request rather than at startup, so nginx
    # starts (and serves the static dashboard) even when the cache service is
    # not yet reachable.
    #
    # 127.0.0.11 is Docker's embedded DNS and is the ONLY resolver that can
    # answer here. A public resolver was once listed alongside it as a
    # "fallback", which it can never be: `dt-violation-cache` is a Docker
    # service name and exists nowhere outside this network, so a public server
    # answers NXDOMAIN. nginx distributes queries across the addresses given,
    # so whenever it chose the public one the lookup failed and every API call
    # in that window returned 502 "could not be resolved (3: Host not found)"
    # while the backend was up and healthy. Intermittent by construction, and
    # `valid=` then cached the bad answer for its duration.
    resolver 127.0.0.11 valid=10s ipv6=off;

    # Serve the dashboard SPA
    # login.html and admin.html are real files, so try_files serves them
    # directly before the /index.html fallback is ever considered. No extra
    # block is needed for either; adding a page needs no nginx change.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Authentication endpoints live on the cache service, not the DT API.
    # Without this block they would fall through to the SPA fallback above and
    # the browser would receive index.html instead of a JSON response.
    location /auth/ {
        set $vcauth "http://dt-violation-cache:3001";
        proxy_pass $vcauth;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        add_header Cache-Control "no-store" always;
    }

    # Read-only administration endpoints. Same backend; listed separately
    # because the SPA fallback above would otherwise swallow them.
    location /admin/ {
        set $vcadmin "http://dt-violation-cache:3001";
        proxy_pass $vcadmin;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        add_header Cache-Control "no-store" always;
    }

    location /profile {
        set $vcprofile "http://dt-violation-cache:3001";
        proxy_pass $vcprofile;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        add_header Cache-Control "no-store" always;
    }

    # Application title and sign-in background. Unauthenticated by design — the
    # sign-in page reads them before a token exists. Without this block they
    # would fall through to the SPA fallback and the page would receive
    # index.html where it expected JSON, silently keeping the default title and
    # never showing an uploaded background.
    #
    # No `Cache-Control: no-store` here, unlike the blocks above: the image URL
    # carries a version derived from its own bytes, and the backend deliberately
    # marks it immutable so a browser fetches it once rather than on every
    # sign-in. Overriding that here would throw the whole point away.
    location /branding {
        set $vcbrand "http://dt-violation-cache:3001";
        proxy_pass $vcbrand;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Proxy violation cache service requests to the dt-violation-cache container.
    # Uses a variable so nginx doesn't fail on startup if the container isn't up yet.
    location /violation-cache/ {
        set $vcache "http://dt-violation-cache:3001";
        proxy_pass $vcache;
        proxy_set_header Host $http_host;
        proxy_read_timeout 300s;   # long enough to cover a full rebuild poll cycle
        add_header Cache-Control "no-store" always;
    }

    # DependencyTrack is NOT proxied here any more.
    # The dashboard reaches it through /violation-cache/dt/, where the cache
    # service attaches the signed-in user's own API key. Forwarding /api/*
    # straight to one shared DependencyTrack instance would defeat both the
    # per-user connection and the rule that a DT key never reaches a browser.

    # Cache static assets
    location ~* \.(js|css|png|jpg|gif|ico|svg|woff2?)$ {
        expires 1d;
        add_header Cache-Control "public, immutable";
    }

    gzip on;
    gzip_types text/plain text/css text/html text/xml application/json application/javascript application/xml image/svg+xml font/woff2;
}
