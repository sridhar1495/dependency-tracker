server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Resolve upstream hostnames per-request rather than at startup, so nginx
    # starts (and serves the static dashboard) even when the cache service is
    # not yet reachable.
    # 127.0.0.11 = Docker's embedded DNS  |  8.8.8.8 = public fallback
    resolver 127.0.0.11 8.8.8.8 valid=10s ipv6=off;

    # Serve the dashboard SPA
    # login.html is a real file, so try_files serves it directly before the
    # /index.html fallback is ever considered.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Authentication endpoints live on the cache service, not the DT API.
    # Without this block they would fall through to the SPA fallback above and
    # the browser would receive index.html instead of a JSON response.
    location /auth/ {
        set $vcauth "http://dt-violation-cache:3001";
        proxy_pass $vcauth;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        add_header Cache-Control "no-store" always;
    }

    location /profile {
        set $vcprofile "http://dt-violation-cache:3001";
        proxy_pass $vcprofile;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        add_header Cache-Control "no-store" always;
    }

    # Proxy violation cache service requests to the dt-violation-cache container.
    # Uses a variable so nginx doesn't fail on startup if the container isn't up yet.
    location /violation-cache/ {
        set $vcache "http://dt-violation-cache:3001";
        proxy_pass $vcache;
        proxy_set_header Host $http_host;
        proxy_read_timeout 300s;   # long enough to cover a full rebuild poll cycle
        add_header Cache-Control "no-store" always;
    }

    # DependencyTrack is NOT proxied here any more.
    # The dashboard reaches it through /violation-cache/dt/, where the cache
    # service attaches the signed-in user's own API key. Forwarding /api/*
    # straight to one shared DependencyTrack instance would defeat both the
    # per-user connection and the rule that a DT key never reaches a browser.

    # Cache static assets
    location ~* \.(js|css|png|jpg|gif|ico|svg|woff2?)$ {
        expires 1d;
        add_header Cache-Control "public, immutable";
    }

    gzip on;
    gzip_types text/plain text/css text/html text/xml application/json application/javascript application/xml image/svg+xml font/woff2;
}
